# Copiar a .env.docker (gitignored) y ajustar si hace falta.
# NUNCA usar credenciales de producción ni hosts remotos.
# Uso: docker compose --env-file .env.docker up --build

# PostgreSQL (solo desarrollo local, red interna Docker)
POSTGRES_USER=supertienda
POSTGRES_PASSWORD=supertienda_dev_change_me
POSTGRES_DB=supertienda_dev
# Opcional: solo si descomentás ports en compose.yaml
# POSTGRES_HOST_PORT=55432

# Backend (publicado solo en 127.0.0.1)
BACKEND_HOST_PORT=5000
BACKEND_PORT=5000
JWT_SECRET=dev-only-local-jwt-secret-change-me
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://127.0.0.1:3000
LOG_LEVEL=info

# Frontend (navegador Windows → API local)
FRONTEND_HOST_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# Rewrites Next dentro de Docker → servicio backend
INTERNAL_API_URL=http://backend:5000
