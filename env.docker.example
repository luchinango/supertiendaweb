# Copiar a .env.docker y ajustar si hace falta.
# NUNCA usar credenciales de producción aquí.
# Uso: docker compose --env-file .env.docker up --build

# PostgreSQL (solo desarrollo local)
POSTGRES_USER=supertienda
POSTGRES_PASSWORD=supertienda_dev
POSTGRES_DB=supertienda_dev
# Puerto host distinto de 5432/5433 (ocupados por PostgreSQL local en esta máquina)
POSTGRES_HOST_PORT=55432

# Backend
BACKEND_HOST_PORT=5000
BACKEND_PORT=5000
JWT_SECRET=dev-only-change-me-not-for-production
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://127.0.0.1:3000
LOG_LEVEL=info

# Frontend (navegador del host)
FRONTEND_HOST_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# Rewrites Next dentro de Docker → servicio backend
INTERNAL_API_URL=http://backend:5000
